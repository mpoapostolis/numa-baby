# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/bun.lock

# env files (can opt-in for committing if needed)
.env*
# Wrangler reads local secrets from here. It is not covered by .env*, and it
# is the one file in this project whose accidental commit would matter.
.dev.vars
.dev.vars.*

# build
/dist/
/.wrangler/
/outputs/
/work/
