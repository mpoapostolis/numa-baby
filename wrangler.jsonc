{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "numa-baby",
  "compatibility_date": "2026-08-06",
  // The apex is the address; www exists only so a typed "www." still lands
  // (the worker 301s it to the apex before anything else runs). The old
  // workers.dev address keeps serving on purpose — every installed PWA out
  // there has its data under that origin, and the handoff flow is how a
  // family moves, one tap, when THEY choose. No blind redirect: a redirect
  // moves the page but not localStorage, which reads as losing everything.
  "routes": [
    { "pattern": "numalog.app", "custom_domain": true },
    { "pattern": "www.numalog.app", "custom_domain": true }
  ],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Not "single-page-application": that answered EVERY unknown URL with the
    // app shell and a 200, so /llms.txt, a typo and a dead inbound link were
    // all soft 404s — a page that says nothing, indexed as if it said
    // something. The one real client route, /handoff, is emitted as its own
    // file by scripts/prerender.mjs, so nothing needs the catch-all any more.
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin"]
  },
  "vars": {
    "TURSO_DATABASE_URL": "https://numa-baby-sync-mpoapostolis.aws-eu-west-1.turso.io"
  },
  "observability": {
    "enabled": true
  }
}
